# ==============================================================================
# ChitramTV UK — Environment Variables & PayPal Configuration
# ==============================================================================

# PayPal REST API Environment ("sandbox" or "production")
PAYPAL_ENVIRONMENT=sandbox

# PayPal REST API Credentials
# Obtain from: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=placeholder_paypal_client_id
PAYPAL_CLIENT_SECRET=placeholder_paypal_client_secret

# PayPal Webhook ID (from Webhook configuration in Developer Dashboard)
PAYPAL_WEBHOOK_ID=placeholder_paypal_webhook_id

# Public Client ID for Frontend PayPal JS SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=placeholder_paypal_client_id

# Optional: Specific PayPal Subscription Plan IDs (from PayPal Subscriptions Dashboard)
# PAYPAL_BILLING_PLAN_PLAN_1M=P-XXXXXX
# PAYPAL_BILLING_PLAN_PLAN_6M=P-YYYYYY
# PAYPAL_BILLING_PLAN_PLAN_14M=P-ZZZZZZ
